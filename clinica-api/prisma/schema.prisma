// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  idRol        Int      @id @default(autoincrement()) @map("id_rol")
  nombreRol    String   @map("nombre_rol") @db.VarChar(100)
  descripcion  String?  @db.VarChar(255)
  usuarios     Usuario[]

  @@map("roles")
}

model Usuario {
  idUsuario           Int      @id @default(autoincrement()) @map("id_usuario")
  nombre              String   @db.VarChar(100)
  apellido1           String   @map("apellido1") @db.VarChar(100)
  apellido2           String?  @map("apellido2") @db.VarChar(100)
  fechaNacimiento     DateTime? @map("fecha_nacimiento") @db.Date
  fechaRegistro       DateTime @default(now()) @map("fecha_registro") @db.Date
  telefonoPrincipal   String?  @map("telefono_principal") @db.VarChar(20)
  telefonoSecundario  String?  @map("telefono_secundario") @db.VarChar(20)
  correoElectronico   String   @unique @map("correo_electronico") @db.VarChar(150)
  contrasena          String   @map("contrasena") @db.VarChar(255)
  direccionResidencia String?  @map("direccion_residencia") @db.VarChar(255)
  clerkId             String?  @unique @map("clerk_id") @db.VarChar(100)
  idRol               Int?     @map("id_rol")
  activo              Boolean  @default(true)
  
  // Relaciones
  rol                 Rol?     @relation(fields: [idRol], references: [idRol])
  perfil              Perfil?
  citasComoPaciente   Cita[]   @relation("CitaPaciente")
  citasComoMedico     Cita[]   @relation("CitaMedico")
  historiasExitoComoMedico   HistoriaExito[] @relation("HistoriaMedico")
  historiasExitoComoPaciente HistoriaExito[] @relation("HistoriaPaciente")
  sesiones            Sesion[]

  @@map("usuarios")
}

model Perfil {
  idPerfil                Int      @id @default(autoincrement()) @map("id_perfil")
  idMedico                Int      @unique @map("id_medico")
  fotografia              String?  @db.VarChar(255)
  experienciaProfesional  String?  @map("experiencia_profesional") @db.Text
  descripcionBreve        String?  @map("descripcion_breve") @db.Text
  especialidad            String?  @db.VarChar(100)
  
  // Relaciones
  medico                  Usuario  @relation(fields: [idMedico], references: [idUsuario], onDelete: Cascade)
  certificaciones         PerfilCertificacion[]
  servicios               PerfilServicio[]

  @@map("perfiles")
}

model Certificacion {
  idCertificacion     Int      @id @default(autoincrement()) @map("id_certificacion")
  nombreCertificacion String   @map("nombre_certificacion") @db.VarChar(150)
  fechaEmision        DateTime? @map("fecha_emision") @db.Date
  
  // Relaciones
  perfiles            PerfilCertificacion[]

  @@map("certificaciones")
}

model PerfilCertificacion {
  idPerfil        Int @map("id_perfil")
  idCertificacion Int @map("id_certificacion")
  
  // Relaciones
  perfil          Perfil        @relation(fields: [idPerfil], references: [idPerfil], onDelete: Cascade)
  certificacion   Certificacion @relation(fields: [idCertificacion], references: [idCertificacion], onDelete: Cascade)

  @@id([idPerfil, idCertificacion])
  @@map("perfil_certificacion")
}

model Servicio {
  idServicio    Int      @id @default(autoincrement()) @map("id_servicio")
  nombreServicio String  @map("nombre_servicio") @db.VarChar(100)
  descripcion   String?  @db.Text
  precio        Decimal? @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  
  // Relaciones
  perfiles      PerfilServicio[]
  citas         Cita[]
  historiasExito HistoriaExito[]

  @@map("servicios")
}

model PerfilServicio {
  idPerfil  Int @map("id_perfil")
  idServicio Int @map("id_servicio")
  
  // Relaciones
  perfil    Perfil   @relation(fields: [idPerfil], references: [idPerfil], onDelete: Cascade)
  servicio  Servicio @relation(fields: [idServicio], references: [idServicio], onDelete: Cascade)

  @@id([idPerfil, idServicio])
  @@map("perfil_servicio")
}

model Cita {
  idCita       Int      @id @default(autoincrement()) @map("id_cita")
  fechaCita    DateTime? @map("fecha_cita") @db.Date
  idPaciente   Int      @map("id_paciente")
  idMedico     Int      @map("id_medico")
  idServicio   Int?     @map("id_servicio")
  descripcion  String?  @db.Text
  estadoCita   String?  @map("estado_cita") @db.VarChar(50)
  
  // Relaciones
  paciente     Usuario      @relation("CitaPaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)
  medico       Usuario      @relation("CitaMedico", fields: [idMedico], references: [idUsuario], onDelete: Cascade)
  servicio     Servicio?    @relation(fields: [idServicio], references: [idServicio], onDelete: SetNull)
  notas        NotaCita[]
  resultados   ResultadoCita[]

  @@map("citas")
}

model NotaCita {
  idNota        Int      @id @default(autoincrement()) @map("id_nota")
  idCita        Int      @map("id_cita")
  nota          String?  @db.Text
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date
  
  // Relaciones
  cita          Cita     @relation(fields: [idCita], references: [idCita], onDelete: Cascade)

  @@map("notas_citas")
}

model ResultadoCita {
  idResultado      Int      @id @default(autoincrement()) @map("id_resultado")
  idCita           Int      @map("id_cita")
  resultado        String?  @db.Text
  resumenResultado String?  @map("resumen_resultado") @db.Text
  fechaRegistro    DateTime? @map("fecha_registro") @db.Date
  
  // Relaciones
  cita             Cita     @relation(fields: [idCita], references: [idCita], onDelete: Cascade)

  @@map("resultados_citas")
}

model HistoriaExito {
  idHistoria       Int      @id @default(autoincrement()) @map("id_historia")
  idServicio       Int?     @map("id_servicio")
  idMedico         Int?     @map("id_medico")
  idPaciente       Int?     @map("id_paciente")
  fechaTratamiento DateTime? @map("fecha_tratamiento") @db.Date
  experiencia      String?  @db.Text
  publicado        Boolean  @default(false)
  fechaPublicacion DateTime? @map("fecha_publicacion") @db.Date
  
  // Relaciones
  servicio         Servicio? @relation(fields: [idServicio], references: [idServicio], onDelete: SetNull)
  medico           Usuario?  @relation("HistoriaMedico", fields: [idMedico], references: [idUsuario], onDelete: SetNull)
  paciente         Usuario?  @relation("HistoriaPaciente", fields: [idPaciente], references: [idUsuario], onDelete: SetNull)

  @@map("historias_exito")
}

model Sesion {
  idSesion        String   @id @default(cuid()) @map("id_sesion")
  idUsuario       Int      @map("id_usuario")
  tokenHash       String   @unique @map("token_hash") @db.VarChar(255)
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")
  expiraEn        DateTime @map("expira_en")
  activa          Boolean  @default(true)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.Text
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario])
  @@index([fechaCreacion])
  @@index([ultimaActividad])
  @@index([activa])
  @@map("sesiones")
}

model Encuesta {
  idEncuesta       Int       @id @default(autoincrement()) @map("id_encuesta")
  calificacion     Int
  idRecepcionista  Int?      @map("id_recepcionista")
  comentario       String?   @db.Text
  fechaRegistro    DateTime  @default(now()) @map("fecha_registro")

  // Relaciones
  recepcionista    Usuario?  @relation(fields: [idRecepcionista], references: [idUsuario], onDelete: SetNull)

  @@map("encuestas")
}


model Auditoria {
  idLog            Int       @id @default(autoincrement()) @map("id_log")
  nombreAccion     String    @map("nombre_accion")
  idUsuario        Int?      @map("id_usuario")
  fechaEjecucion   DateTime  @default(now()) @map("fecha_ejecucion")

  // Relaciones
  usuario          Usuario?  @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull)

  @@map("auditoria")
}


model ExpedienteMedico {
  idExpediente     Int       @id @default(autoincrement()) @map("id_expediente")
  idPaciente       Int       @map("id_paciente")
  idMedico         Int?      @map("id_medico")
  diagnostico      String?   @db.Text
  tratamiento      String?   @db.Text
  observaciones    String?   @db.Text
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")

  // Relaciones
  paciente         Usuario   @relation("ExpedientePaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)
  medico           Usuario?  @relation("ExpedienteMedico", fields: [idMedico], references: [idUsuario], onDelete: SetNull)

  @@map("expedientes_medicos")
}

model Encuesta {
  idEncuesta       Int       @id @default(autoincrement()) @map("id_encuesta")
  calificacion     Int
  idRecepcionista  Int?      @map("id_recepcionista")
  comentario       String?   @db.Text
  fechaRegistro    DateTime  @default(now()) @map("fecha_registro")

  // Relaciones
  recepcionista    Usuario?  @relation(fields: [idRecepcionista], references: [idUsuario], onDelete: SetNull)

  @@map("encuestas")
}

model Auditoria {
  idLog            Int       @id @default(autoincrement()) @map("id_log")
  nombreAccion     String    @map("nombre_accion")
  idUsuario        Int?      @map("id_usuario")
  fechaEjecucion   DateTime  @default(now()) @map("fecha_ejecucion")

  // Relaciones
  usuario          Usuario?  @relation(fields: [idUsuario], references: [idUsuario], onDelete: SetNull)

  @@map("auditoria")
}

model ExpedienteMedico {
  idExpediente     Int       @id @default(autoincrement()) @map("id_expediente")
  idPaciente       Int       @map("id_paciente")
  idMedico         Int?      @map("id_medico")
  diagnostico      String?   @db.Text
  tratamiento      String?   @db.Text
  observaciones    String?   @db.Text
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")

  // Relaciones
  paciente         Usuario   @relation("ExpedientePaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)
  medico           Usuario?  @relation("ExpedienteMedico", fields: [idMedico], references: [idUsuario], onDelete: SetNull)

  @@map("expedientes_medicos")
}
