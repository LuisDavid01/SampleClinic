generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  idRol       Int       @id @default(autoincrement()) @map("id_rol")
  nombreRol   String    @map("nombre_rol") @db.VarChar(100)
  descripcion String?   @db.VarChar(255)
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  idUsuario                  Int                  @id @default(autoincrement()) @map("id_usuario")
  nombre                     String               @db.VarChar(100)
  apellido1                  String               @map("apellido1") @db.VarChar(100)
  apellido2                  String?              @map("apellido2") @db.VarChar(100)
  fechaNacimiento            DateTime?            @map("fecha_nacimiento") @db.Date
  fechaRegistro              DateTime             @default(now()) @map("fecha_registro") @db.Date
  telefonoPrincipal          String?              @map("telefono_principal") @db.VarChar(20)
  telefonoSecundario         String?              @map("telefono_secundario") @db.VarChar(20)
  correoElectronico          String               @unique @map("correo_electronico") @db.VarChar(150)
  contrasena                 String               @map("contrasena") @db.VarChar(255)
  direccionResidencia        String?              @map("direccion_residencia") @db.VarChar(255)
  clerkId                    String?              @unique @map("clerk_id") @db.VarChar(100)
  idRol                      Int?                 @map("id_rol")
  activo                     Boolean              @default(true)
  antecedentesRegistrados    AntecedenteClinico[] @relation("AntecedenteMedico")
  antecedenteClinico         AntecedenteClinico?
  auditoriaAntecedentes      AuditoriaAntecedentes[] @relation("AuditoriaUsuario")
  auditorias                 Auditoria[]
  citasComoMedico            Cita[]               @relation("CitaMedico")
  citasComoPaciente          Cita[]               @relation("CitaPaciente")
  diagnosticosComoDoctor     Diagnostico[]        @relation("DiagnosticoDoctor")
  diagnosticosComoPaciente   Diagnostico[]        @relation("DiagnosticoPaciente")
  encuestas                  Encuesta[]
  expedientesComoMedico      Expediente[]         @relation("ExpedienteMedico")
  expedientesComoPaciente    Expediente[]         @relation("ExpedientePaciente")
  historiasExitoComoMedico   HistoriaExito[]      @relation("HistoriaMedico")
  historiasExitoComoPaciente HistoriaExito[]      @relation("HistoriaPaciente")
  perfil                     Perfil?
  sesiones                   Sesion[]
  rol                        Rol?                 @relation(fields: [idRol], references: [idRol])

  @@map("usuarios")
}

model Perfil {
  idPerfil               Int                   @id @default(autoincrement()) @map("id_perfil")
  idMedico               Int                   @unique @map("id_medico")
  fotografia             String?               @db.VarChar(255)
  experienciaProfesional String?               @map("experiencia_profesional")
  descripcionBreve       String?               @map("descripcion_breve")
  especialidad           String?               @db.VarChar(100)
  certificaciones        PerfilCertificacion[]
  servicios              PerfilServicio[]
  medico                 Usuario               @relation(fields: [idMedico], references: [idUsuario], onDelete: Cascade)

  @@map("perfiles")
}

model Certificacion {
  idCertificacion     Int                   @id @default(autoincrement()) @map("id_certificacion")
  nombreCertificacion String                @map("nombre_certificacion") @db.VarChar(150)
  fechaEmision        DateTime?             @map("fecha_emision") @db.Date
  perfiles            PerfilCertificacion[]

  @@map("certificaciones")
}

model PerfilCertificacion {
  idPerfil        Int           @map("id_perfil")
  idCertificacion Int           @map("id_certificacion")
  certificacion   Certificacion @relation(fields: [idCertificacion], references: [idCertificacion], onDelete: Cascade)
  perfil          Perfil        @relation(fields: [idPerfil], references: [idPerfil], onDelete: Cascade)

  @@id([idPerfil, idCertificacion])
  @@map("perfil_certificacion")
}

model Servicio {
  idServicio     Int              @id @default(autoincrement()) @map("id_servicio")
  nombreServicio String           @map("nombre_servicio") @db.VarChar(100)
  descripcion    String?
  precio         Decimal?         @db.Decimal(10, 2)
  activo         Boolean          @default(true)
  citas          Cita[]
  historiasExito HistoriaExito[]
  perfiles       PerfilServicio[]

  @@map("servicios")
}

model PerfilServicio {
  idPerfil   Int      @map("id_perfil")
  idServicio Int      @map("id_servicio")
  perfil     Perfil   @relation(fields: [idPerfil], references: [idPerfil], onDelete: Cascade)
  servicio   Servicio @relation(fields: [idServicio], references: [idServicio], onDelete: Cascade)

  @@id([idPerfil, idServicio])
  @@map("perfil_servicio")
}

model Cita {
  idCita      Int             @id @default(autoincrement()) @map("id_cita")
  fechaCita   DateTime?       @map("fecha_cita") @db.Date
  idPaciente  Int             @map("id_paciente")
  idMedico    Int             @map("id_medico")
  idServicio  Int?            @map("id_servicio")
  descripcion String?
  estadoCita  String?         @map("estado_cita") @db.VarChar(50)
  medico      Usuario         @relation("CitaMedico", fields: [idMedico], references: [idUsuario], onDelete: Cascade)
  paciente    Usuario         @relation("CitaPaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)
  servicio    Servicio?       @relation(fields: [idServicio], references: [idServicio])
  notas       NotaCita[]
  resultados  ResultadoCita[]

  @@map("citas")
}

model NotaCita {
  idNota        Int      @id @default(autoincrement()) @map("id_nota")
  idCita        Int      @map("id_cita")
  nota          String?
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date
  cita          Cita     @relation(fields: [idCita], references: [idCita], onDelete: Cascade)

  @@map("notas_citas")
}

model ResultadoCita {
  idResultado      Int       @id @default(autoincrement()) @map("id_resultado")
  idCita           Int       @map("id_cita")
  resultado        String?
  resumenResultado String?   @map("resumen_resultado")
  fechaRegistro    DateTime? @map("fecha_registro") @db.Date
  cita             Cita      @relation(fields: [idCita], references: [idCita], onDelete: Cascade)

  @@map("resultados_citas")
}

model HistoriaExito {
  idHistoria       Int       @id @default(autoincrement()) @map("id_historia")
  idServicio       Int?      @map("id_servicio")
  idMedico         Int?      @map("id_medico")
  idPaciente       Int?      @map("id_paciente")
  fechaTratamiento DateTime? @map("fecha_tratamiento") @db.Date
  experiencia      String?
  publicado        Boolean   @default(false)
  fechaPublicacion DateTime? @map("fecha_publicacion") @db.Date
  medico           Usuario?  @relation("HistoriaMedico", fields: [idMedico], references: [idUsuario])
  paciente         Usuario?  @relation("HistoriaPaciente", fields: [idPaciente], references: [idUsuario])
  servicio         Servicio? @relation(fields: [idServicio], references: [idServicio])

  @@map("historias_exito")
}

model Sesion {
  idSesion        String   @id @default(cuid()) @map("id_sesion")
  idUsuario       Int      @map("id_usuario")
  tokenHash       String   @unique @map("token_hash") @db.VarChar(255)
  fechaCreacion   DateTime @default(now()) @map("fecha_creacion")
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")
  expiraEn        DateTime @map("expira_en")
  activa          Boolean  @default(true)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent")
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario])
  @@index([fechaCreacion])
  @@index([ultimaActividad])
  @@index([activa])
  @@map("sesiones")
}

model Encuesta {
  idEncuesta      Int      @id @default(autoincrement()) @map("id_encuesta")
  calificacion    Int      @db.SmallInt
  comentario      String?  @db.Text
  idUsuario       Int      @map("id_usuario")
  fechaRegistro   DateTime @default(now()) @map("fecha_registro")
  usuario         Usuario  @relation(fields: [idUsuario], references: [idUsuario], onDelete: Cascade)

  @@index([idUsuario])
  @@index([fechaRegistro])
  @@map("encuestas")
}

model Auditoria {
  idLog          Int      @id @default(autoincrement()) @map("id_log")
  nombreAccion   String   @map("nombre_accion")
  idUsuario      Int?     @map("id_usuario")
  fechaEjecucion DateTime @default(now()) @map("fecha_ejecucion")
  usuario        Usuario? @relation(fields: [idUsuario], references: [idUsuario])

  @@map("auditoria")
}

model Expediente {
  idExpediente  Int           @id @default(autoincrement()) @map("id_expediente")
  idPaciente    Int           @map("id_paciente")
  cedula        String        @unique @db.VarChar(50)
  estado        String        @db.VarChar(50)
  idMedico      Int?          @map("id_medico")
  descripcion   String?
  fechaCreacion DateTime      @default(now()) @map("fecha_creacion")
  diagnosticos  Diagnostico[]
  documentos    Documento[]
  medico        Usuario?      @relation("ExpedienteMedico", fields: [idMedico], references: [idUsuario])
  paciente      Usuario       @relation("ExpedientePaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)

  @@map("expediente")
}

model Documento {
  idDocumento   Int         @id @default(autoincrement()) @map("id_documento")
  url           String      @db.VarChar(255)
  tipoDocumento String      @map("tipo_documento") @db.VarChar(50)
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion")
  idExpediente  Int?        @map("id_expediente")
  expediente    Expediente? @relation(fields: [idExpediente], references: [idExpediente])

  @@map("documentos")
}

model Diagnostico {
  idDiagnostico Int         @id @default(autoincrement()) @map("id_diagnostico")
  idPaciente    Int         @map("id_paciente")
  fecha         DateTime    @default(now()) @db.Date
  idDoctor      Int?        @map("id_doctor")
  diagnostico   String
  idExpediente  Int?        @map("id_expediente")
  doctor        Usuario?    @relation("DiagnosticoDoctor", fields: [idDoctor], references: [idUsuario])
  expediente    Expediente? @relation(fields: [idExpediente], references: [idExpediente])
  paciente      Usuario     @relation("DiagnosticoPaciente", fields: [idPaciente], references: [idUsuario], onDelete: Cascade)

  @@map("diagnostico")
}

model AntecedenteClinico {
  idAntecedente              Int      @id @default(autoincrement()) @map("id_antecedente")
  idPaciente                 Int      @unique @map("id_paciente")
  historialMedico            String?  @map("historial_medico")
  condicionesPreexistentes   String?  @map("condiciones_preexistentes")
  alergiasMedicamentos       String?  @map("alergias_medicamentos")
  alergiasAlimentos          String?  @map("alergias_alimentos")
  alergiasAmbientales        String?  @map("alergias_ambientales")
  alergiasOtras              String?  @map("alergias_otras")
  medicamentosActuales       String?  @map("medicamentos_actuales")
  medicamentosPrevios        String?  @map("medicamentos_previos")
  cirugiasPrevias            String?  @map("cirugias_previas")
  procedimientosMedicos      String?  @map("procedimientos_medicos")
  hospitalizacionesPrevias   String?  @map("hospitalizaciones_previas")
  antecedentesFamiliares     String?  @map("antecedentes_familiares")
  habitosToxicos             String?  @map("habitos_toxicos")
  urgenciasMedicas           String?  @map("urgencias_medicas")
  contactoEmergenciaNombre   String?  @map("contacto_emergencia_nombre") @db.VarChar(100)
  contactoEmergenciaTelefono String?  @map("contacto_emergencia_telefono") @db.VarChar(20)
  contactoEmergenciaRelacion String?  @map("contacto_emergencia_relacion") @db.VarChar(50)
  fechaCreacion              DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion         DateTime @default(now()) @map("fecha_actualizacion")
  idMedicoRegistro           Int?     @map("id_medico_registro")
  notasAdicionales           String?  @map("notas_adicionales")
  medicoRegistro             Usuario? @relation("AntecedenteMedico", fields: [idMedicoRegistro], references: [idUsuario])
  paciente                   Usuario  @relation(fields: [idPaciente], references: [idUsuario], onDelete: Cascade)

  @@index([idPaciente])
  @@index([idMedicoRegistro])
  @@index([fechaCreacion])
  @@index([fechaActualizacion])
  @@map("antecedentes_clinicos")
}

model AuditoriaAntecedentes {
  id                Int       @id @default(autoincrement()) @map("id")
  accion            String    @map("accion") // CREAR, ACTUALIZAR, CONSULTAR, ELIMINAR
  recurso           String    @map("recurso") // ANTECEDENTES_CLINICOS
  recursoId         Int?      @map("recurso_id") // ID del paciente
  metodo            String    @map("metodo") // GET, POST, PUT, DELETE
  url               String    @map("url")
  statusCode        Int       @map("status_code")
  usuarioId         Int?      @map("usuario_id")
  usuarioInfo       Json?     @map("usuario_info") // Información del usuario de Clerk
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  timestamp         DateTime  @default(now()) @map("timestamp")
  detalles          Json?     @map("detalles") // Request/Response sanitizados

  // Relación con usuario
  usuario           Usuario?  @relation("AuditoriaUsuario", fields: [usuarioId], references: [idUsuario])

  @@index([accion])
  @@index([recurso])
  @@index([recursoId])
  @@index([usuarioId])
  @@index([timestamp])
  @@map("auditoria_antecedentes")
}
